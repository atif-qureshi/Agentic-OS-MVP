<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Calling -->
    <uses-permission android:name="android.permission.CALL_PHONE"/>
    <!-- Voice -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Floating bubble overlay -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Hardware features — not required -->
    <uses-feature android:name="android.hardware.telephony"  android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <!-- Android 11+ app visibility for launching apps -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
        </intent>
        <package android:name="com.google.android.youtube"/>
        <package android:name="com.google.android.apps.maps"/>
        <package android:name="com.google.android.gm"/>
        <package android:name="com.android.chrome"/>
        <package android:name="com.whatsapp"/>
        <package android:name="com.instagram.android"/>
        <package android:name="com.facebook.katana"/>
        <package android:name="com.twitter.android"/>
        <package android:name="com.spotify.music"/>
        <package android:name="com.netflix.mediaclient"/>
        <package android:name="com.google.android.calculator"/>
        <package android:name="com.google.android.calendar"/>
        <package android:name="com.google.android.deskclock"/>
        <package android:name="com.google.android.apps.photos"/>
        <package android:name="com.google.android.apps.docs"/>
        <package android:name="org.telegram.messenger"/>
        <package android:name="com.snapchat.android"/>
        <package android:name="com.zhiliaoapp.musically"/>
        <package android:name="us.zoom.videomeetings"/>
        <package android:name="com.google.android.apps.youtube.music"/>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.AgenticOS">

        <!-- Main Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Instagram Accessibility Service -->
        <service
            android:name=".accessibility.InstagramAccessibilityService"
            android:exported="true"
            android:label="Agentic OS"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>

        <!-- Screen Capture Permission Activity (transparent) -->
        <activity
            android:name=".screen.ScreenPermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"/>

        <!-- Floating Bubble Foreground Service -->
        <service
            android:name=".service.AgentFloatingService"
            android:exported="false"
            android:foregroundServiceType="microphone"/>

        <!-- Screen capture — must be a separate foreground service on Android 10+ -->
        <service
            android:name=".screen.ScreenProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"/>

    </application>

</manifest>
